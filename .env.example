# PeakCut AI Studio - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Server & Network Configuration
PEAKCUT_HOST=127.0.0.1
PEAKCUT_PORT=8765
PEAKCUT_PUBLIC_URL=http://127.0.0.1:8765
PEAKCUT_ACCOUNTS=0

# AI Provider Configuration (Default: Free local Ollama Llama 3.2)
PEAKCUT_AI_PROVIDER=ollama
PEAKCUT_AI_MODELS=llama3.2:latest,llama3.1:8b
PEAKCUT_AI_BASE_URL=http://127.0.0.1:11434/v1

# Video Rendering Specifications
PEAKCUT_FPS=60
PEAKCUT_JOB_WORKERS=4

# Optional Cloud CDN & Zero-PC Storage Offloading
# Set CLOUD_CDN_ENABLED=1 to automatically offload rendered clips to cloud CDN
CLOUD_CDN_ENABLED=1
